    "description": "Maps WCAG 2.2 Level A and AA Success Criteria to Section 508 and EN 301 549 requirements for web content and web-based software. Empty arrays indicate the standard has not yet been updated to include that WCAG version.",
    "notes": {
      "section_508_exceptions": "For non-web documents and software, Section 508 does NOT require: 2.4.1, 2.4.5, 3.2.3, 3.2.4",
      "section_508_coverage": "Only WCAG 2.0 criteria have Section 508 mappings",
      "en_301_549_coverage": "WCAG 2.0 and 2.1 criteria have EN 301 549 mappings (Clause 9 web content, Clause 11 software, and Clause 4 functional performance)",
      "wcag_22_new": "6 new WCAG 2.2 criteria have no mappings yet in either standard"
    },
    "section_508_titles": {
      "501": "Web and Software - WCAG 2.0 Level A/AA conformance",
      "504.2": "Authoring Tool - WCAG 2.0 Level A/AA conformance",
      "602.3": "Support Documentation - WCAG 2.0 Level A/AA conformance"
    },
    "en_301_549_titles": {
      "9": "Web content (direct WCAG reference)",
      "11": "Software (adapted WCAG)",
      "11.8.2": "Authoring Tool",
      "12.1.2": "Product Documentation",
      "12.2.4": "Support Documentation",
      "4.2.1": "Usage without vision",
      "4.2.2": "Usage with limited vision",
      "4.2.3": "Usage without perception of colour",
      "4.2.4": "Usage without hearing",
      "4.2.5": "Usage with limited hearing",
      "4.2.6": "Usage with no or limited vocal capability",
      "4.2.7": "Usage with limited manipulation or strength",
      "4.2.9": "Minimize photosensitive seizure triggers"
    }
